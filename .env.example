# rea-mcp environment variables.
#
# Copy this file to `.env` (git-ignored) or pass the variables to the container.
# Never commit real values. There is no default key: the gateway refuses to
# start without at least one key, and every key must be at least 32 characters.
#
# Generate a key at run time, for example:   openssl rand -hex 32

# --- API keys (at least one source is required) ---------------------------------
# Accepted keys are the union of all three sources below.

# A single key.
REA_MCP_API_KEY=

# Path to a file containing one key (a trailing newline is trimmed), for use
# with Docker/unRAID secrets or a bind-mounted file.
# REA_MCP_API_KEY_FILE=

# Comma-separated list of keys, for rotation: add the new key, move clients,
# then remove the old one.
# REA_MCP_API_KEYS=

# --- Gateway ---------------------------------------------------------------------
# Defaults are shown; uncomment a line only to change it.

# TCP port the gateway listens on.
# PORT=8080

# Maximum concurrent sessions (one REA process each). Requests over the cap get 503.
# MAX_SESSIONS=4

# Seconds of inactivity after which an idle session is reaped.
# SESSION_IDLE_TIMEOUT_SEC=900

# Set to true only behind a trusted reverse proxy or tunnel, so that the client
# address is taken from CF-Connecting-IP / X-Forwarded-For.
# TRUST_PROXY=false

# Comma-separated Host header allowlist for /mcp. Empty or unset disables the check.
# ALLOWED_HOSTS=

# One of: debug, info, warn, error.
# LOG_LEVEL=info

# --- Analysis engines ------------------------------------------------------------

# Passed through unchanged to each REA process when set (milliseconds).
# REA_GHIDRA_STARTUP_TIMEOUT_MS=

# Maximum Java heap for Ghidra, for example a number followed by M or G. Unset
# leaves Ghidra's own default. Size it against MAX_SESSIONS and host RAM.
# GHIDRA_MAX_HEAP=
