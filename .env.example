# rea-mcp environment variables.
#
# Copy this file to `.env` (git-ignored) or pass the variables to the container.
# Never commit real values. There is no default key: the gateway refuses to
# start without at least one key, and every key must be at least 32 characters.
#
# Generate a key at run time, for example:   openssl rand -hex 32

# --- API keys (at least one source is required) ---------------------------------
# Accepted keys are the union of all three sources below.

# A single key.
REA_MCP_API_KEY=

# Path to a file containing one key (a trailing newline is trimmed), for use
# with Docker/unRAID secrets or a bind-mounted file.
# REA_MCP_API_KEY_FILE=

# Comma-separated list of keys, for rotation: add the new key, move clients,
# then remove the old one.
# REA_MCP_API_KEYS=

# --- Gateway ---------------------------------------------------------------------
# Defaults are shown; uncomment a line only to change it.

# TCP port the gateway listens on.
# PORT=8080

# Maximum concurrent sessions (one REA process each). Requests over the cap get 503.
# MAX_SESSIONS=4

# Seconds of inactivity after which an idle session is reaped.
# SESSION_IDLE_TIMEOUT_SEC=900

# Set to true only behind a trusted reverse proxy or tunnel, so that the client
# address is taken from CF-Connecting-IP / X-Forwarded-For.
# TRUST_PROXY=false

# Comma-separated Host header allowlist for /mcp. Empty or unset disables the check.
# ALLOWED_HOSTS=

# One of: debug, info, warn, error.
# LOG_LEVEL=info

# --- Analysis engines ------------------------------------------------------------

# Passed unchanged to each REA process when set (milliseconds). REA's own default is
# 330000 (5.5 minutes); unset leaves it.
# REA_GHIDRA_STARTUP_TIMEOUT_MS=

# Maximum Java heap for Ghidra's JVM: a positive integer, optionally followed by k, m
# or g (for example 512M or 8G). Passed to REA as GHIDRA_HEADLESS_MAXMEM. Unset leaves
# REA's own default, 2G. Size it against MAX_SESSIONS and host RAM: every session has
# its own Ghidra.
# GHIDRA_MAX_HEAP=

# Where REA saves its Ghidra analysis of each binary, shared by all sessions, so that it
# survives a session ending and a restart. OFF unless this is set to an absolute path;
# /work/checkpoints is the recommended value. Read before turning it on:
#   - Names and comments saved in one conversation appear in any later one that opens the
#     same binary.
#   - Only one live session can hold a given binary at a time; a second one fails at once.
#   - Only stock ELF, PE and Mach-O programs open with Ghidra; anything else fails to open.
#   - Nothing is deleted from it, and one directory must serve one container only.
#   - Stopping a session is given 30 seconds instead of 5 so REA can save, so the container
#     needs a stop timeout of at least 40 seconds.
# REA_GHIDRA_PROJECT_PATH, REA_GHIDRA_SEED_FILE, REA_GHIDRA_NATIVEAOT_JAR,
# REA_GHIDRA_LANGUAGE_ID and REA_GHIDRA_DISABLED_ANALYZERS are never passed to REA, because
# it refuses to combine them with this setting.
# REA_GHIDRA_CHECKPOINT_DIR=
